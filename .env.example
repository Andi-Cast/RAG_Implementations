# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real credentials.

# Bedrock API key (bearer token) -- generate one at:
# Bedrock console -> API keys -> Long-term API keys -> Generate.
# This is the current recommended auth method for Bedrock as of the
# console's "API keys" page; it replaces raw AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_PROFILE for this project. Scope its IAM
# policy to just bedrock:InvokeModel (Advanced permissions at creation
# time, or "Manage in IAM Console" afterward) rather than the default
# broader policy.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Bedrock model IDs -- verify exact IDs against your account's Bedrock
# "Model access" page (they vary by region and change over time).
BEDROCK_HAIKU_MODEL_ID=
BEDROCK_GPT_OSS_MODEL_ID=
